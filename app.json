{
  "expo": {
    "name": "shughuli",
    "slug": "shughuli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shughuli.png",
    "scheme": "shughuli",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/shughuli.png",
        "monochromeImage": "./assets/shughuli.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/shughuli.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/shughuli.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/shughuli-chime.wav",
            "./assets/sounds/shughuli-bell.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Shughuli puts your scheduled tasks on the Google Calendar signed in on this phone."
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Shughuli uses Face ID to unlock your tasks on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "db715dcb-4a61-4ed0-8dad-6e863f86f375"
      }
    }
  }
}
