{
  "expo": {
    "name": "shughuli",
    "slug": "shughuli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shughuli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": ["./assets/sounds/shughuli-chime.wav", "./assets/sounds/shughuli-bell.wav"]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Shughuli puts your scheduled tasks on the Google Calendar signed in on this phone."
        }
      ],
      "expo-sharing",
        "expo-secure-store",
        [
          "expo-local-authentication",
          {
            "faceIDPermission": "Shughuli uses Face ID to unlock your tasks on this device."
          }
        ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
