{
  "expo": {
    "name": "shughuli",
    "slug": "shughuli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shughuli.png",
    "scheme": "shughuli",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "shughuli.com",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/shughuli.png",
        "monochromeImage": "./assets/shughuli.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/shughuli.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/shughuli.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/shughuli_chime.wav",
            "./assets/sounds/shughuli_bell.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Shughuli reads event titles, times, and notes on this phone to show your schedule, and writes scheduled tasks to the Google Calendar signed in on this phone."
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Shughuli uses Face ID to unlock your tasks on this device."
        }
      ],
      "./plugins/withOptionalPortrait.js",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "sw",
            "pl",
            "de",
            "fr",
            "es",
            "pt",
            "it",
            "nl",
            "uk",
            "ru",
            "tr",
            "ar",
            "he",
            "fa",
            "hi",
            "bn",
            "ur",
            "zh",
            "zh-Hant",
            "ja",
            "ko",
            "id",
            "ms",
            "vi",
            "th",
            "fil",
            "el",
            "cs",
            "sk",
            "ro",
            "hu",
            "sv",
            "da",
            "nb",
            "fi",
            "hr",
            "bg",
            "sr",
            "sl",
            "lt",
            "lv",
            "et",
            "ca"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f38ab26f-73c5-43c9-95c6-702550ef096b"
      }
    },
    "ios": {
      "bundleIdentifier": "shughuli.com"
    }
  }
}
